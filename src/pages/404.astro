---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page introuvable — Niel Parle" description="Cette page n'existe pas.">
  <Header />
  <main class="not-found site-shell">
    <p class="eyebrow">404</p>
    <h1>Je cherche encore mes mots. Cette page aussi.</h1>
    <a href="/">Retour à l’accueil →</a>
  </main>
  <Footer />
</Layout>

<style>
  .not-found {
    min-height: 70vh;
    padding: 100px 0;
  }

  h1 {
    max-width: 900px;
    margin: 16px 0 40px;
    font-family: var(--serif);
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -.06em;
  }

  a { text-decoration: underline; text-underline-offset: .2em; }
</style>
