<section id="lettre" class="newsletter site-shell">
  <div>
    <p class="eyebrow">La lettre</p>
    <h2>J’apprends à parler français couramment. J’essaie aussi de l’écrire chaque semaine.</h2>
  </div>

  <div class="signup">
    <p>
      Une fois par semaine, j’écris en français sur ce qui me passe par la tête,
      avec mes erreurs et tout le reste. Si tu es arrivé jusqu’ici, peut-être
      que tu veux voir où ça mène.
    </p>

    <form
      id="newsletter-form"
      action="https://app.kit.com/forms/9977355/subscriptions"
      method="post"
    >
      <label class="sr-only" for="email">Adresse e-mail</label>
      <input
        id="email"
        name="email_address"
        type="email"
        placeholder="toi@exemple.com"
        autocomplete="email"
        aria-describedby="form-error"
        required
      />
      <button type="submit">S’inscrire →</button>
    </form>
    <p class="form-error" id="form-error" role="alert"></p>
  </div>

  <script>
    const form = document.querySelector<HTMLFormElement>('#newsletter-form');
    const input = document.querySelector<HTMLInputElement>('#email');
    const button = form?.querySelector('button');
    const error = document.querySelector<HTMLElement>('#form-error');

    // Native validation stays on when JavaScript is unavailable; the script shows its own messages instead.
    if (form) form.noValidate = true;

    const messages = {
      invalid: 'Cette adresse ne semble pas valide. Vérifie-la et réessaie.',
      generic: 'Un problème est survenu. Réessaie dans un instant.',
    };

    function showError(message: string) {
      if (!form || !input || !button || !error) return;
      error.textContent = message;
      input.setAttribute('aria-invalid', 'true');
      form.removeAttribute('aria-busy');
      input.readOnly = false;
      button.disabled = false;
      button.textContent = 'S’inscrire →';
      input.focus();
    }

    form?.addEventListener('submit', async (event) => {
      if (!input || !button || !error) return;
      event.preventDefault();

      error.textContent = '';
      input.removeAttribute('aria-invalid');

      if (!input.value.trim() || !input.checkValidity()) {
        showError(messages.invalid);
        return;
      }

      form.setAttribute('aria-busy', 'true');
      input.readOnly = true;
      button.disabled = true;
      button.textContent = 'Envoi…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json();

        if (result.status === 'success') {
          window.location.assign('/merci/');
          return;
        }

        const fields: unknown = result?.errors?.fields;
        showError(Array.isArray(fields) && fields.includes('email_address') ? messages.invalid : messages.generic);
      } catch {
        showError(messages.generic);
      }
    });
  </script>
</section>

<style>
  .newsletter {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    padding: 80px 0 90px;
    border-top: 1px solid var(--ink);
  }

  .eyebrow { margin: 0 0 18px; }

  h2 {
    max-width: 620px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3rem, 5.5vw, 5.5rem);
    font-weight: 400;
    line-height: .92;
    letter-spacing: -.055em;
  }

  .signup {
    align-self: end;
    max-width: 490px;
  }

  .signup > p:first-child {
    margin: 0 0 30px;
    color: var(--muted);
    line-height: 1.65;
  }

  form {
    display: flex;
    border-bottom: 1px solid var(--ink);
  }

  input {
    min-width: 0;
    flex: 1;
    border: 0;
    padding: 14px 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
  }

  button {
    border: 0;
    padding: 14px 0 14px 24px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  button:hover { color: var(--accent); }

  form:focus-within {
    border-bottom-color: var(--accent);
    box-shadow: 0 1px 0 var(--accent);
  }

  input[aria-invalid='true'] { color: var(--error); }

  button:disabled { cursor: default; color: var(--muted); }

  .form-error {
    min-height: 1.2em;
    margin: 10px 0 0;
    color: var(--error);
    font-size: .8rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .newsletter {
      grid-template-columns: 1fr;
      gap: 44px;
      padding: 64px 0;
    }
  }
</style>
