---
import { Image } from 'astro:assets';
import videos from '../data/videos.json';

const covers = import.meta.glob<{ default: ImageMetadata }>('../assets/videos/*.jpg', { eager: true });

const caption = (title: string) =>
  title.replace(/#\S+/g, '').replace(/[\p{Extended_Pictographic}\u{1F1E6}-\u{1F1FF}]/gu, '').trim();
---

<section id="video" class="video-section site-shell">
  <div class="rule-heading">
    <h2>En vidéo</h2>
    <a class="meta" href="https://www.tiktok.com/@nielparle" target="_blank" rel="noreferrer">@nielparle</a>
  </div>

  <div class="video-intro">
    <h2>J’essaie aussi de le dire à voix haute.</h2>
    <p>
      Une trace plus spontanée du parcours : parler, hésiter, recommencer,
      et laisser les progrès s’accumuler.
    </p>
  </div>

  <ul class="video-grid">
    {videos.map((video) => (
      <li>
        <a href={video.url} target="_blank" rel="noreferrer">
          <Image
            src={covers[`../assets/videos/${video.image}`].default}
            alt=""
            width={360}
            widths={[240, 360]}
            sizes="(max-width: 760px) 45vw, 180px"
            loading="lazy"
          />
          <span class="caption">{caption(video.title)}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="more"><a class="meta" href="https://www.tiktok.com/@nielparle" target="_blank" rel="noreferrer">Voir tout sur TikTok →</a></p>
</section>

<style>
  .video-section { padding-bottom: 80px; }

  .video-intro {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 72px;
    padding: 48px 0 34px;
  }

  .video-intro h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3rem, 6vw, 5.7rem);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -.055em;
  }

  .video-intro p {
    max-width: 460px;
    margin: 5px 0 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 1.5;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 28px 0 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .video-grid a { display: block; }

  .video-grid img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    background: #d8d4cb;
    border-radius: .35rem .05rem .35rem .05rem;
  }

  .caption {
    display: block;
    margin-top: 10px;
    color: var(--muted);
    font-family: var(--serif);
    font-size: .92rem;
    line-height: 1.35;
  }

  .video-grid a:hover .caption { color: var(--accent); }

  .more { margin: 28px 0 0; }

  @media (max-width: 900px) {
    .video-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 760px) {
    .video-intro { grid-template-columns: 1fr; gap: 20px; }
  }

  @media (max-width: 520px) {
    .video-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  }
</style>
